---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found" description="That page is not part of Bastrop Bold.">
  <section class="mx-auto max-w-3xl px-4 py-24">
    <p class="kicker">404</p>
    <h1 class="font-display mt-3 text-5xl">This page is not on the roll.</h1>
    <p class="mt-4 text-lg text-muted">The address does not match a page on Bastrop Bold.</p>
    <a href="/" class="mt-8 inline-block rounded-full bg-pine px-5 py-3 text-sm font-semibold text-paper no-underline">
      Back to the brief
    </a>
  </section>
</Layout>
