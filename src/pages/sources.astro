---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { figures, sources } from "../data/site";

const rules = [
  {
    title: "Two publications, kept separate",
    body: `Building Bastrop County is the local project ledger: investment, abatement status, Pacifico’s full-rate tax, water equivalents, and careers. Tomorrow Begins Here is the broader case: closed-loop water compared with a golf course and a subdivision, the school-funding model, and Texas grid rules. If a sentence names a number, it belongs to one of those sources.`,
  },
  {
    title: "Do not add the tax lines together",
    body: `The EdgeConneX abatement total of ${figures.edgeAbatementPublic} is what Building Bastrop County says the county and ISD receive during the abatement. Tomorrow Begins Here’s ${figures.isdAnnualProjection} a year, ${figures.isdDecadeProjection} over ten years, is an ISD projection for that proposal. They overlap in subject and disagree in amount. Pacifico’s ${figures.pacificoAnnualTax} a year is a different campus, at the full rate. None of these are a single combined annual check.`,
  },
  {
    title: "The before-and-after is the point",
    body: `The land’s published starting point is ${figures.priorAnnualTax} a year. Every commercial figure on this site is being compared with that, and with the service load of houses — about ${figures.subdivisionStudents} students and ${figures.subdivisionDailyWater} for a 1,000-home subdivision.`,
  },
  {
    title: "What this site will not invent",
    body: "No homestead savings calculator, no claim that EdgeConneX is off the grid, and no claim that a reported tenant conversation is a signed lease. Pacifico’s on-site plant is described as grid-independent. EdgeConneX’s 96 megawatts are capacity.",
  },
];
---

<Layout
  title="Sources"
  description="How Bastrop Bold uses figures from Building Bastrop County and Tomorrow Begins Here, and which tax numbers must not be added together."
>
  <PageHero
    kicker="Sources"
    title="Every dollar figure on this site is borrowed, and labeled."
    lede="Bastrop Bold does not appraise property and does not speak for the developers. It organizes what two public sites already report about data centers in Bastrop County."
  />

  <article class="mx-auto max-w-3xl px-4 py-14 md:px-6 md:py-20">
    <ol class="space-y-8">
      {
        rules.map((rule, index) => (
          <li class="border-t border-line pt-6">
            <p class="font-mono text-xs text-copper-deep">0{index + 1}</p>
            <h2 class="font-display mt-2 text-3xl">{rule.title}</h2>
            <p class="mt-3 text-lg leading-relaxed text-muted">{rule.body}</p>
          </li>
        ))
      }
    </ol>

    <section class="mt-12">
      <h2 class="font-display text-3xl">Read them yourself</h2>
      <ul class="mt-5 space-y-5">
        {
          sources.map((source) => (
            <li>
              <a class="font-medium underline underline-offset-2" href={source.href} rel="noopener noreferrer">
                {source.name}
              </a>
              <p class="mt-1 text-sm leading-relaxed text-muted">{source.note}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</Layout>
