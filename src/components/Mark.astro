---
interface Props {
  light?: boolean;
  class?: string;
}

const { light = false, class: className = "" } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2.5", className]}>
  <svg viewBox="0 0 32 32" class="h-8 w-8 shrink-0" aria-hidden="true">
    <rect width="32" height="32" rx="4" fill={light ? "#faf7f2" : "#17241c"}></rect>
    <path
      d="M9 7h9.2c3.4 0 5.5 1.7 5.5 4.4 0 1.9-1.1 3.3-2.8 4 2.1.6 3.4 2.3 3.4 4.5 0 3.1-2.4 5.1-6.2 5.1H9V7zm4.2 7.2h4.4c1.4 0 2.2-.7 2.2-1.7s-.8-1.6-2.2-1.6h-4.4v3.3zm0 7.3h5c1.6 0 2.5-.8 2.5-1.9s-.9-1.8-2.5-1.8h-5v3.7z"
      fill={light ? "#17241c" : "#e7d3c0"}></path>
    <rect x="9" y="25.5" width="14" height="1.6" fill="#c4622d"></rect>
  </svg>
  <span class="leading-none">
    <span
      class:list={[
        "block font-sans text-[0.62rem] font-semibold tracking-[0.22em]",
        light ? "text-paper/70" : "text-muted",
      ]}
    >
      BASTROP
    </span>
    <span class:list={["font-display block text-[1.35rem] leading-none", light ? "text-paper" : "text-ink"]}>
      Bold
    </span>
  </span>
</span>
