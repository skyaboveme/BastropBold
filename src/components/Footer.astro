---
import { nav, site, sources } from "../data/site";
import Mark from "./Mark.astro";
---

<footer class="border-t border-line bg-pine text-paper">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 md:grid-cols-[1.3fr_0.8fr_1.2fr] md:px-6">
    <div>
      <Mark light />
      <p class="mt-4 max-w-sm text-sm leading-relaxed text-paper/75">
        {site.tagline} Figures on this site come from Building Bastrop County and Tomorrow Begins Here. Where those
        sources publish different totals, both are shown and neither is added to the other.
      </p>
    </div>
    <div>
      <p class="font-mono text-[0.68rem] tracking-[0.16em] text-paper/50 uppercase">On this site</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="no-underline hover:text-white" href="/">Home</a></li>
        {
          nav.map((item) => (
            <li>
              <a class="no-underline hover:text-white" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li><a class="no-underline hover:text-white" href="/sources">Sources</a></li>
      </ul>
    </div>
    <div>
      <p class="font-mono text-[0.68rem] tracking-[0.16em] text-paper/50 uppercase">Reported by</p>
      <ul class="mt-3 space-y-3 text-sm">
        {
          sources.slice(0, 2).map((source) => (
            <li>
              <a class="underline decoration-paper/30 underline-offset-2" href={source.href} rel="noopener noreferrer">
                {source.name}
              </a>
            </li>
          ))
        }
        <li>
          <a class="underline decoration-paper/30 underline-offset-2" href="https://tomorrowbeginshere.com/" rel="noopener noreferrer">
            Tomorrow Begins Here
          </a>
        </li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="mx-auto max-w-6xl px-4 py-4 text-xs text-paper/50 md:px-6">
      Bastrop Bold is a public brief for Bastrop County residents. It is not a county office and it does not speak for the companies building the campuses.
    </p>
  </div>
</footer>
