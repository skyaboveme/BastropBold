---
import { nav } from "../data/site";
import Mark from "./Mark.astro";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="sticky top-0 z-40 border-b border-line/90 bg-sand/92 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 md:px-6">
    <a href="/" class="no-underline" aria-label="Bastrop Bold, home">
      <Mark />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
      {
        nav.map((item) => {
          const active = path === item.href;
          return (
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              class:list={[
                "rounded-full px-3 py-1.5 text-sm font-medium no-underline",
                active ? "bg-pine text-paper" : "text-ink hover:bg-stone",
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <details class="relative lg:hidden">
      <summary
        class="cursor-pointer list-none rounded-full border border-line bg-paper px-3 py-1.5 text-sm font-medium"
      >
        Menu
      </summary>
      <nav
        class="absolute right-0 mt-2 w-52 rounded-2xl border border-line bg-paper p-2 shadow-lg"
        aria-label="Mobile"
      >
        {
          nav.map((item) => (
            <a
              href={item.href}
              class="block rounded-xl px-3 py-2 text-sm font-medium no-underline hover:bg-sand"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
